# Local agent settings and scratch worktrees — machine-specific
.claude/settings.local.json
**/.claude/worktrees/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Never commit secrets. The repo holds pointers only (spec §12.4).
*.env
.env*
*.key
*.pem
credentials*.json
token*.json

# Client-supplied document containing plaintext account passwords.
# Must never enter git history. Delete once credentials are rotated and
# stored in Keychain / a password manager. (See DECISIONS.md D-008.)
Completed System Setup and Access Requirements*.pdf

# Build/data artifacts — the LMS repo proper lives on the Mac, but guard anyway
*.db
*.db-wal
*.db-shm
__pycache__/

# Python
.pytest_cache/
*.pyc
.venv/

# Generated per-machine by ops/bringup_mac.sh. Paths only, but machine-specific
# — the Mac's volume layout is not the workstation's.
lms/ops/lms.env
